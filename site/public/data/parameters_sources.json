[{"id": "P01", "parameter": "max_slope_nominal", "applies_to": "rover (Ay; VIPER)", "value": "15", "unit": "degree", "kind": "Simülasyon varsayımı (aracın planlama sınırı)", "source_title": "NASA VIPER Lunar Operations", "source_url": "https://science.nasa.gov/mission/viper/lunar-operations/", "verbatim_quote": "VIPER can generally drive on a slope of up to 15 degrees.", "selectable_in_ui": "yes", "status": "DOĞRULANDI (sayfa okundu)", "verified_on": "2026-11-13", "notes": "Yalnızca VIPER'a özgü. Genel Ay gezgini sınırı değildir."}, {"id": "P02", "parameter": "max_slope_extended", "applies_to": "rover (Ay; VIPER)", "value": "25-30", "unit": "degree", "kind": "Simülasyon varsayımı (riskli üst sınır)", "source_title": "NASA VIPER Lunar Operations", "source_url": "https://science.nasa.gov/mission/viper/lunar-operations/", "verbatim_quote": "It can tackle a slope of 25 or 30 degrees when necessary, but the likelihood of slipping increases and slows the rover down.", "selectable_in_ui": "no (aralık; tek değer yok)", "status": "DOĞRULANDI (sayfa okundu)", "verified_on": "2026-11-13", "notes": "Rota maliyetinde kullanılmaz; yalnızca duyarlılık için not."}, {"id": "P03", "parameter": "tilt_avoid_limit", "applies_to": "rover (Mars; Perseverance)", "value": "30", "unit": "degree", "kind": "Simülasyon varsayımı (sürücü planlama sınırı; yatış açısı)", "source_title": "JPL PIA26402 Perseverance at base of Jezero rim", "source_url": "https://www.jpl.nasa.gov/images/pia26402-perseverances-location-at-the-base-of-jezero-craters-rim/", "verbatim_quote": "rover drivers plan routes to avoid slopes that would tilt the rover more than 30 degrees", "selectable_in_ui": "yes (yatış sınırı; yüzey eğimiyle birebir aynı değil)", "status": "DOĞRULANDI (sayfa okundu)", "verified_on": "2026-11-13", "notes": "Yatış (tilt) sınırıdır; tırmanma kabiliyeti sınırı değildir. Arayüzde bu ayrım yazılır."}, {"id": "P04", "parameter": "slope_expected_on_route", "applies_to": "rover (Mars; Perseverance)", "